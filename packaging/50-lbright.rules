// LBrightness: allow the active local user to start ONLY the ambient light
// sensor reset unit (no password prompt). Nothing else is granted.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "lbright-als-reset.service" &&
        action.lookup("verb") == "start" &&
        subject.local && subject.active) {
        return polkit.Result.YES;
    }
});
