[Unit]
Description=LBrightness: reset stuck ambient light sensor driver
Documentation=https://github.com/LeanBitLab/adaptive-brightness-linux

[Service]
Type=oneshot
ExecStart=/usr/libexec/lbright/als-reset
NoNewPrivileges=true
PrivateTmp=true
PrivateNetwork=true
ProtectHome=true
ProtectSystem=strict
